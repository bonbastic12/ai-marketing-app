# GEMINI_API_KEY: Required for server-side Gemini AI ad generation and chat
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY: Alternative alias for custom AI model endpoints
AI_API_KEY="MY_AI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Relational database connection string (PostgreSQL / Cloud SQL)
DATABASE_URL="postgresql://user:password@localhost:5432/digital_product"

# GOOGLE_CLIENT_ID: OAuth 2.0 Client ID for Google Workspace and Google sign-in
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# META_MARKETING_API_TOKEN: System User token for automated Meta Ad Placement
META_MARKETING_API_TOKEN="EAAB..."

# STRIPE_SECRET_KEY: Secret key for Stripe Checkout and Billing Portal
STRIPE_SECRET_KEY="sk_test_..."

# CHAPA_SECRET_KEY: For Ethiopian Birr (ETB) and Telebirr digital payments
CHAPA_SECRET_KEY="CHASECK_TEST-..."

